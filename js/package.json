{
  "name": "max-node-vitest",
  "version": "0.0.1",
  "author": "Henrique Matias <mail@hems.io>",
  "type": "module",
  "scripts": {
    "build": "tsc",
    "build:watch": "tsc --watch",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
