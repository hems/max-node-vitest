    "test:coverage:html": "vitest run --coverage && open-cli coverage/index.html"
  },
  "devDependencies": {
    "@types/node": "^24.1.0",
    "@vitest/coverage-v8": "^1.0.0",
    "open-cli": "^8.0.0",
    "typescript": "^5.0.0",
    "vitest": "^1.0.0"
  }
}
